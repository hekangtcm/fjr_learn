{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["esnext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "jsxImportSource": "@tarojs/react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@booknest/domain": ["../../packages/domain/src"]
    }
  },
  "include": ["./src", "./types"],
  "exclude": ["node_modules", "dist"]
}
